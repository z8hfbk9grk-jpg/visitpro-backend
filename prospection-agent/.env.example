# Modèle de variables d'environnement.
# Sur Render, ces valeurs se saisissent dans l'onglet "Environment" de chaque service.
# Ne mettez JAMAIS vos vraies clés dans GitHub.

# Base Neon (Dashboard Neon > Connect > "Connection string")
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Clé API Claude (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Modèle Claude utilisé (laisser tel quel sauf besoin particulier)
CLAUDE_MODEL=claude-opus-5-5

# Clé API Resend pour l'envoi d'emails (resend.com > API Keys)
RESEND_API_KEY=re_...
# Expéditeur : doit être une adresse d'un domaine vérifié dans Resend.
# Pour tester sans domaine : onboarding@resend.dev (n'envoie qu'à l'adresse de votre compte Resend)
EMAIL_FROM=Agent Prospection <prospection@votre-domaine.fr>
# Destinataire du récapitulatif quotidien (vous)
EMAIL_TO=vous@exemple.fr

# Mot de passe pour accéder à la page web de l'agent
ADMIN_PASSWORD=choisissez-un-mot-de-passe-long

# Adresse publique de la page web (fournie par Render), sans "/" à la fin
PUBLIC_URL=https://prospection-agent.onrender.com

# Informations sur votre conciergerie (utilisées dans les messages d'approche)
CONCIERGERIE_NOM=Ma Conciergerie
CONCIERGERIE_SIGNATURE=Prénom Nom - Ma Conciergerie - 06 00 00 00 00
CONCIERGERIE_PITCH=Conciergerie Airbnb locale à Val d'Europe, Disneyland et Meaux : photos pro, optimisation des prix, gestion des voyageurs et du ménage.

# Nombre maximum d'annonces traitées par jour (maîtrise du coût API)
MAX_ANNONCES_PAR_JOUR=20
# Durée de conservation des prospects (RGPD), en jours
DUREE_CONSERVATION_JOURS=90
